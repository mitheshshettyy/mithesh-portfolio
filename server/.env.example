# ============================================================
#  Portfolio Backend — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  Never commit .env — it is gitignored.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP — Gmail App Password ────────────────────────────────
# See README.md for step-by-step Gmail App Password setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL_HERE
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE
CONTACT_EMAIL=YOUR_EMAIL_HERE

# ── Rate Limiting ────────────────────────────────────────────
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum contact form submissions per window per IP
RATE_LIMIT_MAX_REQUESTS=5

# ── Resume (optional — overrides built-in defaults) ─────────
RESUME_FILE_PATH=../public/resume/YourName_Resume.pdf
RESUME_PUBLIC_URL=http://localhost:5173/resume/YourName_Resume.pdf

# ── Personal Info for /api/portfolio endpoint ───────────────
PERSONAL_NAME=Your Full Name
PERSONAL_ROLE=Software Developer
PERSONAL_UNIVERSITY=Your University
PERSONAL_YEAR=4th Year
PERSONAL_GRAD_YEAR=2027
PERSONAL_CGPA=0.00/10.0
PERSONAL_EMAIL=YOUR_EMAIL_HERE
PERSONAL_GITHUB=https://github.com/YOUR_USERNAME_HERE
PERSONAL_LINKEDIN=https://linkedin.com/in/YOUR_USERNAME_HERE
PERSONAL_AVAILABILITY=Open to Opportunities
