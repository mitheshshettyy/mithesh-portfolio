# ============================================================
#  Portfolio Backend — Environment Variables
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (for contact form — uses Nodemailer or Resend)
EMAIL_SERVICE=resend  # or nodemailer, sendgrid
EMAIL_FROM=noreply@alexchen.dev
EMAIL_TO=alex.chen@iiitd.ac.in
RESEND_API_KEY=re_xxxx_xxxx  # or use SMTP credentials

# SMTP (if using Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=10   # max contact form submissions per window

# Resume
RESUME_FILE_PATH=./assets/resume.pdf
RESUME_PUBLIC_URL=https://alexchen.dev/resume.pdf
