# ============================================================
#  Portfolio Backend — Environment Variables Template
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/portfolio

# Email (for contact form — uses Nodemailer or Resend)
EMAIL_SERVICE=resend  # or nodemailer, sendgrid
EMAIL_FROM=noreply@shettymithesh030.com
EMAIL_TO=shettymithesh030@gmail.com
RESEND_API_KEY=re_xxxx_xxxx  # or use SMTP credentials

# SMTP — Gmail with App Password (see server/README.md for setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shettymithesh030@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
CONTACT_EMAIL=shettymithesh030@gmail.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=10   # max contact form submissions per window

# Resume Configuration
RESUME_FILE_PATH=../public/resume/Mithesh_R_Shetty.pdf
RESUME_PUBLIC_URL=http://localhost:5173/resume/Mithesh_R_Shetty.pdf

# Personal Info for Backend APIs
PERSONAL_NAME=Mithesh R Shetty
PERSONAL_ROLE=Full-Stack Developer & CS Student
PERSONAL_UNIVERSITY=NMAM Institute of Technology, Nitte, Karnataka
PERSONAL_YEAR=4th Year
PERSONAL_GRAD_YEAR=2027
PERSONAL_CGPA=8.78/10.0
PERSONAL_EMAIL=shettymithesh030@gmail.com
PERSONAL_GITHUB=https://github.com/mitheshshettyy
PERSONAL_LINKEDIN=https://linkedin.com/in/mithesh-shetty030
PERSONAL_AVAILABILITY=Open to Opportunities — Summer 2027
