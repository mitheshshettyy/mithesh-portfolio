# ============================================================
#  Portfolio Frontend — Environment Variables Template
# ============================================================

# ── Resume Configuration ─────────────────────────────────────
VITE_RESUME_PATH=/resume/YourName_Resume.pdf
VITE_RESUME_FILENAME=YourName_Resume.pdf
VITE_RESUME_DOWNLOAD_NAME=YourName_Resume.pdf
VITE_RESUME_LAST_UPDATED=YYYY-MM-DD
VITE_RESUME_VERSION=v1

# ── Personal Information ─────────────────────────────────────
VITE_PERSONAL_NAME=Your Full Name
VITE_PERSONAL_SHORT_NAME=YourFirstName
VITE_PERSONAL_ROLE=Your Role
VITE_PERSONAL_TAGLINE=Your tagline here.
VITE_PERSONAL_DEGREE=Your Degree
VITE_PERSONAL_UNIVERSITY=Your University
VITE_PERSONAL_CGPA=0.00 / 10.0
VITE_PERSONAL_GRAD_YEAR=2027
VITE_PERSONAL_LOCATION=Your City, Country
VITE_PERSONAL_STATUS=Your availability status

# ── Contact Information ──────────────────────────────────────
VITE_CONTACT_EMAIL=YOUR_EMAIL_HERE
VITE_CONTACT_GITHUB=https://github.com/YOUR_USERNAME_HERE
VITE_CONTACT_LINKEDIN=https://linkedin.com/in/YOUR_USERNAME_HERE
VITE_CONTACT_LEETCODE=https://leetcode.com/YOUR_USERNAME_HERE/
VITE_CONTACT_PORTFOLIO_URL=https://yourportfolio.com

# ── Terminal Configuration ───────────────────────────────────
VITE_TERMINAL_USER=youruser
VITE_TERMINAL_HOST=portfolio
VITE_TERMINAL_SHELL=zsh
VITE_TERMINAL_THEME=NightShell Dark
VITE_TERMINAL_VERSION=5.9
VITE_TERMINAL_INSTALL_DATE=YYYY-MM-DDTHH:MM:SS
VITE_TERMINAL_DEFAULT_CMD=help

# ── Neofetch Configuration ───────────────────────────────────
VITE_NEOFETCH_OS=Portfolio OS v2.0.0
VITE_NEOFETCH_HOST=portfolio.local
VITE_NEOFETCH_SHELL=zsh 5.9
VITE_NEOFETCH_TERMINAL=NightShell Client
VITE_NEOFETCH_FRAMEWORK=React 19
VITE_NEOFETCH_RUNTIME=Node.js 22
VITE_NEOFETCH_THEME=NightShell Dark

# ── Website Metadata ─────────────────────────────────────────
VITE_SITE_TITLE=Your Name
VITE_SITE_META_DESC=Your site description.
VITE_SITE_KEYWORDS=Your Name, Portfolio, Software Engineer
VITE_SITE_AUTHOR=Your Name
VITE_SITE_COPYRIGHT=© 2026 Your Name

# ── Backend Config ───────────────────────────────────────────
# Development: http://localhost:3001
# Production:  https://your-backend.onrender.com
VITE_API_URL=http://localhost:3001